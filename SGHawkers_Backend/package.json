{
  "name": "sghawkers-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "SGHawkers API — Express + PostgreSQL + WebSocket",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:setup": "psql -U postgres -c \"CREATE DATABASE sghawkers;\" && psql -U postgres -d sghawkers -f src/db/schema.sql && psql -U postgres -d sghawkers -f src/db/seed.sql",
    "db:schema": "psql -U postgres -d sghawkers -f src/db/schema.sql",
    "db:seed": "psql -U postgres -d sghawkers -f src/db/seed.sql",
    "db:reset": "psql -U postgres -c \"DROP DATABASE IF EXISTS sghawkers; CREATE DATABASE sghawkers;\" && npm run db:schema && npm run db:seed"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.5",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
